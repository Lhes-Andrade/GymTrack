@model GymTrack.Models.Usuario
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card login-gym shadow-lg border-0">
            <div class="card-body p-5">

                <!-- ENCABEZADO -->
                <div class="text-center mb-4">
                    <div class="display-5">💪</div>
                    <h2 class="fw-bold text-uppercase mb-0">Únete a Gym<span class="text-warning">Track</span></h2>
                    <p class="text-white-50 text-uppercase small">Tu progreso empieza hoy</p>
                </div>

                <form asp-action="Registro" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-uppercase small fw-bold text-warning">Nombre</label>
                        <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Tu nombre completo" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-uppercase small fw-bold text-warning">Correo</label>
                            <input asp-for="Correo" type="email" class="form-control form-control-lg" placeholder="tucorreo@ejemplo.com" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-uppercase small fw-bold text-warning">Celular</label>
                            <input asp-for="Celular" class="form-control form-control-lg" placeholder="3001234567" />
                            <span asp-validation-for="Celular" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-uppercase small fw-bold text-warning">Clave</label>
                        <input asp-for="Clave" type="password" class="form-control form-control-lg" placeholder="••••••••" />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>

                    <button class="btn btn-warning btn-lg w-100 fw-bold text-uppercase">Crear mi cuenta</button>
                </form>

                <p class="text-center mt-4 mb-0 text-white-50">
                    ¿Ya tienes cuenta?
                    <a href="/Login" class="text-warning fw-bold">Inicia sesión</a>
                </p>
            </div>
        </div>
    </div>
</div>