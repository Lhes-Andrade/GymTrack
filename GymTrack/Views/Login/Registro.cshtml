@model GymTrack.Models.Usuario

<h2>Crear Cuenta</h2>

<form asp-action="Registro" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Correo</label>
        <input asp-for="Correo" type="email" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Celular</label>
        <input asp-for="Celular" class="form-control" />
        <span asp-validation-for="Celular" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Clave</label>
        <input asp-for="Clave" type="password" class="form-control" />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>
    <hr />
    <button class="btn btn-success">Registrarme</button>
    <a class="btn btn-secondary" href="/Login">Cancelar</a>
</form>