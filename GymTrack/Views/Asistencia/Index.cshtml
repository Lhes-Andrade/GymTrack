@model List<GymTrack.Models.Asistencia>

<h2 class="mb-4">Mi Asistencia</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a class="btn btn-success mb-3" href="/Asistencia/Create">+ Marcar Asistencia</a>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">Todavía no has marcado asistencia.</div>
}
else
{
    <!-- RESUMEN -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            Días que asististe: <span class="badge bg-success">@Model.Count(a => a.Asistio)</span>
            &nbsp; Días que faltaste: <span class="badge bg-danger">@Model.Count(a => !a.Asistio)</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Nota</th>
                    <th class="text-center text-nowrap">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Asistio)
                            {
                                <span class="badge bg-success">Asistió</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No asistió</span>
                            }
                        </td>
                        <td>@item.Nota</td>
                        <td class="text-center text-nowrap">
                            <a class="btn btn-warning" href="/Asistencia/Edit/@item.Id">Editar</a>
                            <a class="btn btn-danger" href="/Asistencia/Delete/@item.Id"
                               onclick="return confirm('¿Seguro que deseas eliminar esta asistencia?');">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}