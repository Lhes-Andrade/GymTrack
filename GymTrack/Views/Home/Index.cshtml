@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5 text-center">
    <h1 class="mb-4">Bienvenido @Context.Session.GetString("Usuario")</h1>
    <div class="row justify-content-center">
        <div class="col-md-3">
            <a href="/Ejercicio" class="btn btn-primary w-100 mb-3">Ejercicios</a>
        </div>
        <div class="col-md-3">
            <a href="/Rutina" class="btn btn-success w-100 mb-3">Rutinas</a>
        </div>
        @if (Context.Session.GetString("Rol") == "Cliente")
        {
            <div class="col-md-3">
                <a href="/Entrenamiento" class="btn btn-warning w-100 mb-3">Mis Entrenamientos</a>
            </div>
        }
    </div>
</div>